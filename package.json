{
  "name": "mta-university-library-collector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MTA University Library Collector — academic directory, curricula explorer, digital library and moderated PDF repository by MTA TECHNOLOGIES.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/status.test.ts server/tests/academic.test.ts server/tests/api.test.ts server/tests/security.test.ts server/tests/backup.test.ts",
    "db:backup": "tsx server/scripts/backup.ts",
    "db:restore": "tsx server/scripts/restore.ts",
    "db:integrity": "tsx server/scripts/integrity.ts"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor-community/firebase-analytics": "8.1.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

