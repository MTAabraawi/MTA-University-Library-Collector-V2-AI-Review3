# ============================================================================
# MTA University Library Collector — Environment Variables Template
# الجهة المطورة والمالكة: MTA TECHNOLOGIES (mtatechnologies0@gmail.com)
#
# إرشادات: انسخ هذا الملف إلى .env واضبط القيم بما يتناسب مع بيئتك.
# لا تضع أي كلمات مرور أو مفاتيح سرية حقيقية داخل المستودع العام.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. إعدادات الشبكة وبيئة التشغيل (Network & Runtime)
# ----------------------------------------------------------------------------
# بيئة التشغيل: development للتطوير، أو production للإنتاج
NODE_ENV=development
# منفذ الخادم (الافتراضي: 3000)
PORT=3000
# واجهة الشبكة للاستماع (0.0.0.0 للاستماع على كافة الواجهات والحاويات، أو 127.0.0.1 للمحلي فقط)
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# 2. مسارات حفظ البيانات والتخزين الدائم (Storage & Database Locations)
# ----------------------------------------------------------------------------
# مجلد البيانات الأساسي (قاعدة البيانات والنسخ الاحتياطية)
MTA_DATA_DIR=./data
# مسار ملف قاعدة بيانات SQLite الفعلي
MTA_DB_PATH=./data/mta_academic.db
# مجلد تخزين ملفات الـ PDF المرفوعة (يشمل الحجر الصحي والمجلد المعتمد)
MTA_UPLOADS_DIR=./data/uploads

# ----------------------------------------------------------------------------
# 3. إعدادات الجلسات وسقوف الأمان (Sessions & Rate Limits)
# ----------------------------------------------------------------------------
# صلاحية جلسة تسجيل الدخول بالأيام (TTL)
SESSION_DAYS=7
# الحد الأقصى لحجم ملف الـ PDF المسموح برفعه (بالميجابايت)
MAX_UPLOAD_MB=25
# الحد الأقصى لحجم حمولة طلبات JSON النصية لمنع هجمات حجب الخدمة
JSON_BODY_LIMIT=2mb
# سقف عدد مرات رفع الملفات لكل مستخدم/IP في الساعة الواحدة
UPLOAD_RATE_LIMIT_PER_HOUR=5
# سقف محاولات تسجيل الدخول الفاشلة لكل IP خلال 15 دقيقة
LOGIN_RATE_LIMIT_PER_15_MIN=10
# سقف تسجيل الحسابات الجديدة لكل IP في الساعة الواحدة
REGISTER_RATE_LIMIT_PER_HOUR=5
# سقف تقديم البلاغات والشكاوى الأكاديمية لكل IP في الساعة الواحدة
REPORT_RATE_LIMIT_PER_HOUR=10

# ----------------------------------------------------------------------------
# 4. سياسات الوصول والوكيل المعكوس (CORS & Proxy Policies)
# ----------------------------------------------------------------------------
# قائمة النطاقات المصرح لها بالاتصال (مفصولة بفواصل). اتركه فارغاً لاستخدام النطاقات المحلية وتطبيق أندرويد تلقائياً.
CORS_ORIGINS=
# تفعيل الثقة في ترويسات الوكيل المعكوس (Nginx / Cloudflare). اضبطه true في الإنتاج خلف وكيل.
TRUST_PROXY=false

# ----------------------------------------------------------------------------
# 5. تهيئة الحساب الإداري الأولي وتجاوز البيانات (Super Admin Bootstrap)
# ----------------------------------------------------------------------------
# البريد الإلكتروني للمشرف العام الأولي (Super Admin)
MTA_ADMIN_EMAIL=mtatechnologies0@gmail.com
# كلمة المرور الأولية للمشرف: اتركها فارغة ليقوم النظام تلقائياً بتوليد كلمة مرور مشفرة معقدة لمرة واحدة
# وتخزينها في ملف مقيد الصلاحيات data/initial-admin-credentials.txt، أو اكتب كلمة مرور قوية هنا بنفسك.
MTA_INITIAL_ADMIN_PASSWORD=
# تجاوز إدخال البيانات المبدئية عند كل إقلاع (true للإنتاج المستقر، false للتطوير)
MTA_SKIP_SEED=false

# ----------------------------------------------------------------------------
# 6. خدمات الطرف الثالث (Firebase / Analytics / AdMob)
# ----------------------------------------------------------------------------
# تفعيل الإعلانات من جهة الخادم (يجب أن يبقى false أثناء التطوير والاختبار، ولا يُفعل إلا بعد اعتماد UMP والمتجر)
MTA_ADS_ENABLED=false
# تفعيل التحليلات الإحصائية (يبقى false في التطوير لمنع تلويث الإحصائيات)
MTA_ANALYTICS_ENABLED=false
# تفعيل خدمات Firebase العامة
MTA_FIREBASE_ENABLED=false

# ----------------------------------------------------------------------------
# 7. عناوين الواجهة الأمامية وتطبيق أندرويد (Client & Capacitor URLs)
# ----------------------------------------------------------------------------
# مسار الـ API الذي تتصل به الواجهة الأمامية (اتركه فارغاً لاستخدام المسار المدمج النسبي /api)
VITE_API_BASE_URL=
# رابط خادم خارجي لتطبيق Capacitor (اتركه فارغاً ليقوم تطبيق أندرويد بقراءة الملفات المحلية المدمجة داخل الـ APK)
CAPACITOR_SERVER_URL=


